      {
        "aftertaste": {
          "description": "拥有<color=#f29e38ff>【坚防守备】</color>的敌方单位被<color=#f29e38ff>弱点击破</color>时，使我方全体行动提前并恢复战技点。\n敌方全体受到的追加攻击伤害提高<color=#f29e38ff><unbreak>25%</unbreak></color>，终结技伤害提高<color=#f29e38ff><unbreak>15%</unbreak></color>。",
          "id": 3110003,
          "name": "末法余烬"
        },
        "battles": [
          {
            "axiomSet": {
              "key": "as:3003:BuffList1",
              "options": [
                {
                  "description": "角色造成的追加攻击伤害无视敌方目标<color=#f29e38ff><unbreak>15%</unbreak></color>的全属性抗性，同时对非弱点目标也能削减韧性，效果等同于原技能削韧值的<color=#f29e38ff><unbreak>50%</unbreak></color>。",
                  "id": 3111021,
                  "name": "时来运转",
                  "order": 1
                },
                {
                  "description": "角色造成的冰属性伤害提高<color=#f29e38ff><unbreak>55%</unbreak></color>。",
                  "id": 3111022,
                  "name": "千金一掷",
                  "order": 2
                },
                {
                  "description": "角色击破敌方目标弱点时，行动提前<color=#f29e38ff><unbreak>15%</unbreak></color>，该效果每回合最多触发<color=#f29e38ff><unbreak>1</unbreak></color>次。",
                  "id": 3111023,
                  "name": "追亡逐北",
                  "order": 3
                }
              ]
            },
            "bossGuide": {
              "key": "as:30031:MonsterID1",
              "traits": [
                {
                  "description": "首领幻影受到的伤害降低<color=#f29e38ff><unbreak>50%</unbreak></color>。<color=#f29e38ff>弱点击破</color>后，行动额外延后，受到的伤害提高<color=#f29e38ff><unbreak>100%</unbreak></color>。",
                  "id": 100501,
                  "linkedEffects": [],
                  "name": "坚防守备",
                  "order": 1
