    "encounters": [
      {
        "aftertaste": {
          "description": "拥有<color=#f29e38ff>【坚防守备】</color>的敌方目标被<color=#f29e38ff>弱点击破</color>时，使我方全体目标解除控制状态并激活终结技。\n敌方全体目标受到的欢愉伤害提高<color=#f29e38ff><unbreak>25%</unbreak></color>，弱点击破伤害提高<color=#f29e38ff><unbreak>15%</unbreak></color>。",
          "id": 3110016,
          "name": "末法余烬"
        },
        "battles": [
          {
            "axiomSet": {
              "key": "as:3017:BuffList1",
              "options": [
                {
                  "description": "敌方全体受到的欢愉伤害提高<color=#f29e38ff><unbreak>30%</unbreak></color>。我方队伍中存在欢愉命途的角色时，我方全体的弱点击破效率提高<color=#f29e38ff><unbreak>50%</unbreak></color>。",
                  "id": 3111089,
                  "name": "喜上眉梢",
                  "order": 1
                },
                {
                  "description": "敌方全体受到的击破伤害提高<color=#f29e38ff><unbreak>10%</unbreak></color>。击破敌方弱点后，我方全体速度提高<color=#f29e38ff><unbreak>15%</unbreak></color>，持续<color=#f29e38ff><unbreak>2</unbreak></color>回合。",
                  "id": 3111086,
                  "name": "望风瓦解",
                  "order": 2
                },
                {
                  "description": "队伍中的第1位角色施放终结技后，使自身的弱点击破效率提高<color=#f29e38ff><unbreak>50%</unbreak></color>，暴击伤害提高<color=#f29e38ff><unbreak>50%</unbreak></color>，持续<color=#f29e38ff><unbreak>1</unbreak></color>回合。",
                  "id": 3111064,
                  "name": "登锋陷阵",
                  "order": 3
                }
              ]
            },
            "bossGuide": {
              "key": "as:30171:MonsterID1",
              "traits": [
                {
                  "description": "首领幻影受到的伤害降低<color=#f29e38ff><unbreak>50%</unbreak></color>。<color=#f29e38ff>弱点击破</color>后，行动额外延后，受到的伤害提高<color=#f29e38ff><unbreak>100%</unbreak></color>。",
                  "id": 101601,
                  "linkedEffects": [],
                  "name": "坚防守备",
                  "order": 1
                },
                {
                  "description": "首领幻影会在战斗中开启<u>连麦PK</u>，选择一名我方角色前往副战场战斗，其余角色留在主战场提供支援。<u>连麦PK</u>开启后，处于主战场的敌方目标受到的伤害降低，并免疫控制类负面状态，首领幻影进入【<u>韧性锁止</u>】状态。首领幻影的回合开始时，【我方人气值】和【对方人气值】均重置为初始状态。",
                  "id": 101602,
                  "linkedEffects": [
                    {
                      "description": "我方全体目标将分别在<color=#f29e38ff>主战场和副战场</color>进行作战。在阿哈时刻以外，不同战场的我方和敌方目标<color=#f29e38ff>无法攻击</color>到另一战场的目标。在阿哈时刻期间，欢愉技始终只能对<color=#f29e38ff>副战场</color>的敌方目标发动攻击。\n连麦PK倒计时结束、处于副战场的我方角色陷入无法战斗状态、处于副战场的所有敌方目标被消灭、副战场没有可以战斗的我方角色，以上任意条件触发时，连麦PK解除。",
                      "id": "501401001",
                      "name": "连麦PK"
                    },
                    {
                      "description": "韧性值无法被削减至低于1点。",
                      "id": "70000318",
                      "name": "韧性锁止"
                    }
                  ],
                  "name": "双重战场",
                  "order": 2
                }
              ]
            },
