      {
        "aftertaste": {
          "description": "拥有<color=#f29e38ff>【坚防守备】</color>的敌方单位被<color=#f29e38ff>弱点击破</color>时，使我方全体角色恢复战技点并激活终结技。\n敌方全体受到的弱点击破伤害提高<color=#f29e38ff><unbreak>20%</unbreak></color>，追加攻击伤害提高<color=#f29e38ff><unbreak>20%</unbreak></color>。",
          "id": 3110004,
          "name": "末法余烬"
        },
        "battles": [
          {
            "axiomSet": {
              "key": "as:3004:BuffList1",
              "options": [
                {
                  "description": "我方全体普攻造成的伤害提高<color=#f29e38ff><unbreak>50%</unbreak></color>。",
                  "id": 3111028,
                  "name": "支配万物",
                  "order": 1
                },
                {
                  "description": "消灭敌方目标后，我方全体目标行动提前<color=#f29e38ff><unbreak>10%</unbreak></color>。",
                  "id": 3111027,
                  "name": "意气激昂",
                  "order": 2
                },
                {
                  "description": "角色造成的追加攻击伤害无视敌方目标<color=#f29e38ff><unbreak>15%</unbreak></color>的全属性抗性，同时对非弱点目标也能削减韧性，效果等同于原技能削韧值的<color=#f29e38ff><unbreak>50%</unbreak></color>。",
                  "id": 3111021,
                  "name": "时来运转",
                  "order": 3
                }
              ]
            },
