          {
            "axiomSet": {
              "key": "as:3014:BuffList1",
              "options": [
                {
                  "description": "我方全体目标造成的击破伤害提高<color=#f29e38ff><unbreak>10%</unbreak></color>，当场上有敌方目标进入弱点击破状态后额外提高<color=#f29e38ff><unbreak>5%</unbreak></color>，最多叠加<color=#f29e38ff><unbreak>4</unbreak></color>次。",
                  "id": 3111077,
                  "name": "攻心扼吭",
                  "order": 1
                },
                {
                  "description": "编队中的第1位角色造成的伤害无视敌方目标<color=#f29e38ff><unbreak>15%</unbreak></color>的防御力。",
                  "id": 3111078,
                  "name": "摧锋陷阵",
                  "order": 2
                },
                {
                  "description": "我方目标每次消耗战技点后，使自身暴击伤害提高<color=#f29e38ff><unbreak>6%</unbreak></color>，最多叠加<color=#f29e38ff><unbreak>10</unbreak></color>层。",
