{
  "presentation": {
    "defaultEncounterId": "30164",
    "encounters": [
      {
        "aftertaste": {
          "description": "拥有<color=#f29e38ff>【坚防守备】</color>的敌方目标被<color=#f29e38ff>弱点击破</color>时，使我方全体目标解除控制状态、恢复战技点、立即行动并使阿哈立即获得一个额外回合（本回合固定计入<color=#f29e38ff><unbreak>10</unbreak></color>笑点）。\n敌方全体目标受到的欢愉伤害提高<color=#f29e38ff><unbreak>25%</unbreak></color>，弱点击破伤害提高<color=#f29e38ff><unbreak>15%</unbreak></color>。",
          "id": 3110015,
          "name": "末法余烬"
        },
        "battles": [
          {
            "axiomSet": {
              "key": "as:3016:BuffList1",
              "options": [
                {
                  "description": "我方全体造成的欢愉伤害无视敌方目标<color=#f29e38ff><unbreak>15%</unbreak></color>的全属性抗性。破坏敌方目标的【战甲】或【百炼战甲】时，获得<color=#f29e38ff><unbreak>3</unbreak></color>笑点。",
                  "id": 3111083,
                  "name": "以柔克刚",
                  "order": 1
                },
                {
                  "description": "我方目标施放终结技后，使自身战技造成的暴击伤害提高<color=#f29e38ff><unbreak>50%</unbreak></color>，持续<color=#f29e38ff><unbreak>2</unbreak></color>回合。",
                  "id": 3111084,
                  "name": "气涌如山",
                  "order": 2
                },
                {
                  "description": "我方全体造成的追加攻击和终结技伤害提高<color=#f29e38ff><unbreak>50%</unbreak></color>，对弱点击破状态下的敌方目标额外提高<color=#f29e38ff><unbreak>50%</unbreak></color>。",
                  "id": 3111085,
                  "name": "可乘之隙",
                  "order": 3
                }
              ]
            },
            "bossGuide": {
              "key": "as:30161:MonsterID1",
              "traits": [
                {
                  "description": "首领幻影受到的伤害降低<color=#f29e38ff><unbreak>50%</unbreak></color>。<color=#f29e38ff>弱点击破</color>后，行动额外延后，受到的伤害提高<color=#f29e38ff><unbreak>100%</unbreak></color>。",
                  "id": 101401,
                  "linkedEffects": [],
                  "name": "坚防守备",
                  "order": 1
                },
                {
                  "description": "首领幻影和其召唤物拥有<color=#f29e38ff><u>【战甲】</u></color>，使自身受到的伤害降低。在第二阶段<color=#f29e38ff><u>【战甲】</u></color>会强化为<color=#f29e38ff><u>【百炼战甲】</u></color>，层数上限大幅提高，首领幻影还会额外获得韧性保护。",
                  "id": 101402,
                  "linkedEffects": [
                    {
                      "description": "受到的伤害降低。受到攻击后根据攻击者的【荣耀】层数减少自身【战甲】，减少到0层时，【战甲】被破坏，对自身造成大量虚数属性伤害，削减自身韧性，并使自身行动延后，使我方恢复战技点。【战甲】被破坏后，自身受到攻击时额外再受到少量虚数属性伤害。【战甲】在自身回合结束时恢复到最大层数。",
                      "id": "240140133",
                      "name": "战甲"
                    },
                    {
                      "description": "受到的伤害降低。受到攻击后根据攻击者的【荣耀】层数减少自身【百炼战甲】，减少到0层时，【百炼战甲】被破坏，对自身造成大量虚数属性伤害，削减自身大量韧性，并使自身行动延后，使我方恢复战技点，并使攻击者获得一定层数的【荣耀】。【百炼战甲】被破坏后，自身受到攻击时额外再受到少量虚数属性伤害。【百炼战甲】在自身回合结束时如果层数为0，则恢复到最大层数。",
                      "id": "240140134",
                      "name": "百炼战甲"
                    }
                  ],
                  "name": "铁甲森森",
                  "order": 2
                }
              ]
            },
