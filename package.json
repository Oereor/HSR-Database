{
  "name": "hsr-database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:sync:enemies": "pnpm data:ensure && tsx scripts/assets/enemies/sync.ts",
    "assets:ensure:enemies": "tsx scripts/assets/enemies/ensure.ts",
    "assets:sync": "tsx scripts/assets/sync.ts",
    "assets:ensure": "tsx scripts/assets/ensure.ts",
    "assets:validate": "tsx scripts/assets/validate.ts",
    "assets:verify": "tsx scripts/assets/verify.ts",
    "assets:clean": "tsx scripts/assets/clean.ts",
    "deploy:verify": "tsx scripts/deployment/verify-build.ts",
    "data:audit": "tsx scripts/data/audit.ts",
    "data:sync": "tsx scripts/data/sync.ts",
    "data:validate": "tsx scripts/data/validate.ts",
    "data:measure": "tsx scripts/data/measure-generated.ts",
    "data:ensure": "tsx scripts/data/ensure.ts",
    "debug:pf-hp": "tsx scripts/data/debug-pf-hp.ts",
    "investigate:enemy-variants": "tsx scripts/investigations/enemy-variants.ts",
    "predev": "pnpm data:ensure && pnpm assets:ensure",
    "dev": "vite dev",
    "deploy:build": "tsx scripts/deployment/build.ts",
    "deploy:build:clean": "tsx scripts/deployment/clean.ts",
    "upstreams:update": "tsx scripts/update-upstream-lock.ts",
    "prebuild": "pnpm data:ensure && pnpm assets:ensure",
    "build": "vite build",
    "preview": "vite preview",
    "check": "pnpm messages:check && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && pnpm check:scripts",
    "check:scripts": "pnpm messages:check && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "data:search-names:update": "tsx scripts/data/search-names.ts update",
    "data:search-names:check": "tsx scripts/data/search-names.ts check",
    "data:player-aliases:sync": "tsx scripts/data/player-aliases.ts",
    "messages:compile": "tsx scripts/messages.ts",
    "messages:check": "tsx scripts/messages.ts",
    "product:baseline:check": "tsx scripts/product-baseline/cli.ts check",
    "product:baseline:search:update": "tsx scripts/product-baseline/cli.ts update-search",
    "product:baseline:update": "tsx scripts/product-baseline/cli.ts update"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "2.25.0",
    "@inlang/plugin-message-format": "4.4.0",
    "@playwright/test": "latest",
    "@sveltejs/adapter-static": "latest",
    "@sveltejs/kit": "latest",
    "@sveltejs/vite-plugin-svelte": "latest",
    "@tailwindcss/vite": "latest",
    "@types/node": "latest",
    "eslint": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-svelte": "latest",
    "globals": "latest",
    "lossless-json": "latest",
    "mdsvex": "0.12.8",
    "prettier": "latest",
    "prettier-plugin-svelte": "latest",
    "prettier-plugin-tailwindcss": "latest",
    "sharp": "^0.35.3",
    "svelte": "latest",
    "svelte-check": "latest",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "5.9.3",
    "typescript-eslint": "latest",
    "vite": "7.2.4",
    "vitest": "latest",
    "xxhash-wasm": "latest"
  },
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "flexsearch": "0.8.212"
  }
}
